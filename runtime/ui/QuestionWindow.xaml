<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      UseLayoutRounding="True" SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Display">
  <Grid.Resources>
    <SolidColorBrush x:Key="Ink" Color="#514236"/>
    <SolidColorBrush x:Key="Line" Color="#D7C9B5"/>
    <Style TargetType="Button" x:Key="SendArrowButton">
      <Setter Property="Width" Value="32"/>
      <Setter Property="Height" Value="32"/>
      <Setter Property="Background" Value="#B87948"/>
      <Setter Property="Foreground" Value="#FFF7E8"/>
      <Setter Property="BorderBrush" Value="#895532"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value><ControlTemplate TargetType="Button">
          <Grid>
            <Border x:Name="Foot" Background="#895532" Margin="0,2,0,0"/>
            <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="2" Margin="0,0,0,2">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="#C68A57"/></Trigger>
            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Margin" Value="0,2,0,0"/></Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#563A28"/></Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Surface" Property="Background" Value="#D8D1C5"/>
              <Setter TargetName="Surface" Property="BorderBrush" Value="#BCB3A5"/>
              <Setter TargetName="Foot" Property="Background" Value="#BCB3A5"/>
              <Setter Property="Foreground" Value="#AAA194"/>
              <Setter Property="Cursor" Value="Arrow"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="ScrollBar" x:Key="PixelScrollBar">
      <Setter Property="Width" Value="10"/>
      <Setter Property="Margin" Value="9,0,0,0"/>
      <Setter Property="Background" Value="#E7DBC7"/>
      <Setter Property="Template">
        <Setter.Value><ControlTemplate TargetType="ScrollBar">
          <Border Background="{TemplateBinding Background}">
            <Track x:Name="PART_Track" Orientation="Vertical" IsDirectionReversed="True"
                   Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}"
                   ViewportSize="{TemplateBinding ViewportSize}"
                   Value="{Binding Value,RelativeSource={RelativeSource TemplatedParent},Mode=TwoWay}">
              <Track.DecreaseRepeatButton>
                <RepeatButton Command="ScrollBar.PageUpCommand" Focusable="False" Opacity="0"/>
              </Track.DecreaseRepeatButton>
              <Track.Thumb>
                <Thumb MinHeight="28" Cursor="Hand">
                  <Thumb.Template><ControlTemplate TargetType="Thumb">
                    <Border x:Name="ThumbSurface" Background="#B78D59" BorderBrush="#9B764C" BorderThickness="1"/>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ThumbSurface" Property="Background" Value="#A57946"/></Trigger>
                      <Trigger Property="IsDragging" Value="True"><Setter TargetName="ThumbSurface" Property="Background" Value="#936739"/></Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate></Thumb.Template>
                </Thumb>
              </Track.Thumb>
              <Track.IncreaseRepeatButton>
                <RepeatButton Command="ScrollBar.PageDownCommand" Focusable="False" Opacity="0"/>
              </Track.IncreaseRepeatButton>
            </Track>
          </Border>
        </ControlTemplate></Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="Button" x:Key="QuietButton">
      <Setter Property="Foreground" Value="#756452"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="8,7"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value><ControlTemplate TargetType="Button">
          <Border x:Name="Surface" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="#EADCC7"/></Trigger>
            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Background" Value="#DDCCB2"/></Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="Background" Value="#EADCC7"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="RadioButton" x:Key="AnswerOption">
      <Setter Property="GroupName" Value="Answer"/>
      <Setter Property="Foreground" Value="#594B3E"/>
      <Setter Property="Background" Value="#FAF5EB"/>
      <Setter Property="BorderBrush" Value="#DCCFBC"/>
      <Setter Property="Margin" Value="0,0,0,10"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="MinHeight" Value="49"/>
      <Setter Property="Template">
        <Setter.Value><ControlTemplate TargetType="RadioButton">
          <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="2" Padding="13,6">
            <ContentPresenter VerticalAlignment="Stretch" HorizontalAlignment="Stretch"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#BCA182"/></Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#A9633B"/></Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Surface" Property="Background" Value="#F0DFBF"/>
              <Setter TargetName="Surface" Property="BorderBrush" Value="#B58A57"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value>
      </Setter>
    </Style>
  </Grid.Resources>
  <Path x:Name="Shadow" Fill="#663B2C25" IsHitTestVisible="False"/>
  <Path x:Name="Frame" Fill="#5A4535"/>
  <Path x:Name="Paper" Fill="#F6EDD9" IsHitTestVisible="False"/>
  <Path x:Name="Highlight" Stroke="#FFF9EB" StrokeThickness="2" IsHitTestVisible="False"/>
  <Path x:Name="Tail" Fill="#F6EDD9" Stroke="#5A4535" StrokeThickness="3" IsHitTestVisible="False"/>
  <Grid x:Name="CardContent" Margin="33,20,51,20" TextElement.Foreground="{StaticResource Ink}">
    <Grid.RowDefinitions>
      <RowDefinition Height="32"/>
      <RowDefinition Height="1"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*" MinHeight="66" MaxHeight="200"/>
      <RowDefinition Height="10"/>
      <RowDefinition Height="38"/>
      <RowDefinition Height="8"/>
      <RowDefinition Height="24"/>
    </Grid.RowDefinitions>
    <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/><ColumnDefinition Width="27"/></Grid.ColumnDefinitions>
      <Canvas Width="20" Height="20" HorizontalAlignment="Left" VerticalAlignment="Center" RenderOptions.EdgeMode="Aliased">
        <Path Fill="#B88850" Data="M 3,1 H 17 V 3 H 19 V 14 H 17 V 16 H 10 V 18 H 7 V 21 H 4 V 16 H 1 V 3 H 3 Z"/>
        <Rectangle Canvas.Left="5" Canvas.Top="6" Width="3" Height="3" Fill="#FFF5DF"/>
        <Rectangle Canvas.Left="12" Canvas.Top="6" Width="3" Height="3" Fill="#FFF5DF"/>
        <Rectangle Canvas.Left="7" Canvas.Top="11" Width="6" Height="2" Fill="#FFF5DF"/>
      </Canvas>
      <TextBlock Grid.Column="1" Text="Sumika" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
      <Button x:Name="CloseButton" Grid.Column="2" Style="{StaticResource QuietButton}" Padding="5" Width="26" Height="26" AutomationProperties.Name="关闭问题窗口">
        <Path Stroke="#8D7A62" StrokeThickness="2" Width="10" Height="10" Data="M 0,0 L 10,10 M 0,10 L 10,0" RenderOptions.EdgeMode="Aliased"/>
      </Button>
    </Grid>
    <Border Grid.Row="1" Background="#DCCEB8" Margin="0,4,0,-4"/>
    <ScrollViewer x:Name="QuestionScroll" Grid.Row="2" MaxHeight="90" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="False" PanningMode="VerticalOnly" Focusable="False" UseLayoutRounding="False" SnapsToDevicePixels="False" Margin="0,18,0,14" AutomationProperties.Name="问题正文">
      <ScrollViewer.Resources><Style TargetType="ScrollBar" BasedOn="{StaticResource PixelScrollBar}"/></ScrollViewer.Resources>
      <TextBlock x:Name="Question" Text="接下来，先完善哪一部分？" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap" LineHeight="26"/>
    </ScrollViewer>
    <ScrollViewer x:Name="OptionsScroll" Grid.Row="3" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="False" PanningMode="VerticalOnly" Focusable="False" UseLayoutRounding="False" SnapsToDevicePixels="False" AutomationProperties.Name="问题选项">
      <ScrollViewer.Resources><Style TargetType="ScrollBar" BasedOn="{StaticResource PixelScrollBar}"/></ScrollViewer.Resources>
      <StackPanel x:Name="Options"/>
    </ScrollViewer>
    <Grid Grid.Row="5">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="38"/></Grid.ColumnDefinitions>
      <Border x:Name="InputBorder" Background="#FFF9EF" BorderBrush="#D8C8AF" BorderThickness="2" Height="38">
        <Grid>
          <TextBox x:Name="ReplyText" Padding="10,0" VerticalContentAlignment="Center" Background="Transparent" BorderThickness="0" Foreground="#514236" CaretBrush="#A3683F" FontSize="14" AcceptsReturn="False" TextWrapping="NoWrap" VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Hidden" AutomationProperties.Name="输入回复"/>
          <TextBlock x:Name="Placeholder" Text="输入回复…" FontSize="14" Foreground="#B2A18A" Margin="11,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
        </Grid>
      </Border>
      <Button x:Name="SendButton" Grid.Column="2" Style="{StaticResource SendArrowButton}" Width="38" Height="38" IsEnabled="False" AutomationProperties.Name="发送回复" ToolTip="发送回复">
        <Path x:Name="SendGlyph" Fill="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}" Width="14" Height="14" Data="M 0,5 H 7 V 1 H 9 V 3 H 11 V 5 H 13 V 7 H 11 V 9 H 9 V 11 H 7 V 7 H 0 Z" Stretch="Uniform" RenderOptions.EdgeMode="Aliased"/>
      </Button>
    </Grid>
    <Grid Grid.Row="7">
      <Button x:Name="SessionButton" Content="去 DSH 查看" Style="{StaticResource QuietButton}" HorizontalAlignment="Left" Padding="0,0,9,0"/>
      <StackPanel x:Name="Pages" Orientation="Horizontal" HorizontalAlignment="Right" Visibility="Collapsed">
        <Button x:Name="PreviousPage" Content="‹" Style="{StaticResource QuietButton}" Padding="8,0" AutomationProperties.Name="上一题"/>
        <TextBlock x:Name="PageNumber" VerticalAlignment="Center" FontSize="12"/>
        <Button x:Name="NextPage" Content="›" Style="{StaticResource QuietButton}" Padding="8,0" AutomationProperties.Name="下一题"/>
      </StackPanel>
    </Grid>
  </Grid>
</Grid>
