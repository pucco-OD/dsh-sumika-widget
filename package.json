{
  "name": "dsh-sumika-widget",
  "version": "1.0.0",
  "type": "module",
  "description": "随 DeepSeek Harness 工作的桌面角色。",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "desktop",
    "widget",
    "pet",
    "wpf"
  ],
  "author": "pucco-OD",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pucco-OD/dsh-sumika-widget.git"
  },
  "homepage": "https://github.com/pucco-OD/dsh-sumika-widget#readme",
  "bugs": {
    "url": "https://github.com/pucco-OD/dsh-sumika-widget/issues"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.png"
  },
  "files": [
    "index.js",
    "controller.js",
    "lifecycle.js",
    "agent-state.js",
    "questions.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.png",
    "runtime/",
    "licenses/",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  },
  "os": [
    "win32"
  ],
  "cpu": [
    "x64"
  ]
}
